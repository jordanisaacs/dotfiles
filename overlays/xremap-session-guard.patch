+    fn call_socket_path<T: serde::Serialize>(path: &Path, command: T) -> Result<String> {
+        // One deadline covers connection, writes and every response fragment.
+        // Per-read timeouts alone allow a stalled or drip-feeding bridge to
+        // hold the physical-keyboard event loop indefinitely.
+        let deadline = Instant::now() + Duration::from_millis(500);
+        let mut stream = connect_socket(path, deadline).context(format!("Could not connect to socket: {:?}", path))?;
+        let mut request = serde_json::to_vec(&command)?;
+        request.push(b'\n');
+        let mut pending = request.as_slice();
+        while !pending.is_empty() {
+            wait_ready(&stream, PollFlags::POLLOUT, deadline)?;
+            match stream.write(pending) {
+                Ok(0) => bail!("bridge closed while writing"),
+                Ok(written) => pending = &pending[written..],
+                Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => continue,
+                Err(err) => return Err(err.into()),
+            }
+        }
+        let mut response = Vec::new();
+        loop {
+            wait_ready(&stream, PollFlags::POLLIN, deadline)?;
+            let mut chunk = [0; 4096];
+            let count = match stream.read(&mut chunk) {
+                Ok(0) if response.is_empty() => bail!("bridge closed without a response"),
+                Ok(0) => return Ok(String::from_utf8(response)?),
+                Ok(count) => count,
+                Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => continue,
+                Err(err) => return Err(err.into()),
+            };
+            let end = chunk[..count].iter().position(|byte| *byte == b'\n');
+            response.extend_from_slice(&chunk[..end.map_or(count, |end| end + 1)]);
+            if response.len() > 1024 * 1024 {
+                bail!("bridge response exceeds one MiB");
+            }
+            if end.is_some() {
+                return Ok(String::from_utf8(response)?);
+            }
+        }
+    }
+}
+
+fn wait_ready(stream: &UnixStream, events: PollFlags, deadline: Instant) -> Result<()> {
+    loop {
+        let remaining = deadline
+            .checked_duration_since(Instant::now())
+            .ok_or_else(|| anyhow!("bridge request timed out"))?;
+        let timeout = remaining.as_millis().clamp(1, 500) as u16;
+        let mut descriptors = [PollFd::new(stream.as_fd(), events)];
+        match poll(&mut descriptors, timeout) {
+            Ok(0) => bail!("bridge request timed out"),
+            Ok(_) => return Ok(()),
+            Err(Errno::EINTR) => continue,
+            Err(err) => return Err(err.into()),
+        }
+    }
+}
+
+fn connect_socket(path: &Path, deadline: Instant) -> Result<UnixStream> {
+    let path = path.as_os_str().as_bytes();
+    // sockaddr_un is a plain C structure; zeroing initializes its path padding.
+    let mut address: nix::libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    if path.is_empty() || path.contains(&0) || path.len() >= address.sun_path.len() {
+        bail!("invalid bridge socket path");
+    }
+    address.sun_family = nix::libc::AF_UNIX as _;
+    for (slot, byte) in address.sun_path.iter_mut().zip(path) {
+        *slot = *byte as _;
+    }
+    // The fresh descriptor is checked before OwnedFd takes exclusive ownership.
+    let descriptor = unsafe {
+        nix::libc::socket(
+            nix::libc::AF_UNIX,
+            nix::libc::SOCK_STREAM | nix::libc::SOCK_CLOEXEC | nix::libc::SOCK_NONBLOCK,
+            0,
+        )
+    };
+    if descriptor < 0 {
+        return Err(std::io::Error::last_os_error().into());
+    }
+    let descriptor = unsafe { OwnedFd::from_raw_fd(descriptor) };
+    let stream = UnixStream::from(descriptor);
+    // The initialized address remains alive for the full connect syscall.
+    let connected = unsafe {
+        nix::libc::connect(
+            stream.as_raw_fd(),
+            &address as *const nix::libc::sockaddr_un as *const nix::libc::sockaddr,
+            std::mem::size_of_val(&address) as _,
+        )
+    };
+    if connected < 0 {
+        let error = Errno::last();
+        if error != Errno::EINPROGRESS {
+            // AF_UNIX reports a saturated listen backlog as EAGAIN. No
+            // connection is pending in that case: leave the key unchanged.
+            return Err(error.into());
+        }
+        wait_ready(&stream, PollFlags::POLLOUT, deadline)?;
+        if let Some(error) = stream.take_error()? {
+            return Err(error.into());
+        }
+        stream.peer_addr()?;
+    }
+    Ok(stream)
 }
 
