 mod tests {
     use super::*;
+    use std::path::PathBuf;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct CgroupTree(PathBuf);
+
+    impl CgroupTree {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let path = std::env::temp_dir().join(format!(
+                "app-rummage-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed),
+            ));
+            std::fs::create_dir_all(&path).unwrap();
+            Self(path)
+        }
+
+        fn pids(&self, unit: &str, pids: &[u32]) {
+            let dir = self.0.join(unit);
+            std::fs::create_dir_all(&dir).unwrap();
+            let contents = pids.iter().map(|pid| format!("{pid}\n")).collect::<String>();
+            std::fs::write(dir.join("cgroup.procs"), contents).unwrap();
+        }
+    }
+
+    impl Drop for CgroupTree {
+        fn drop(&mut self) {
+            std::fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    fn application(id: &str, executable: &str) -> ApplicationEntry {
+        ApplicationEntry {
+            id: Rc::from(id),
+            name: Rc::from(id),
+            exec: Some(Rc::from(executable)),
+            exec_args: Vec::new(),
+            icon: None,
+        }
+    }
+
+    #[test]
+    fn uwsm_nested_slices_instances_and_descendants() {
+        let tree = CgroupTree::new();
+        let unit = "app-graphical.slice/app-work.slice/app-river-org.example.foo\\x2dbar@deadbeef.service";
+        tree.pids(unit, &[41]);
+        tree.pids(&format!("{unit}/renderer.scope"), &[42, 41]);
+        tree.pids("app-graphical.slice/app-river-org.example.foo\\x2dbar@0123abcd.service", &[43]);
+        tree.pids("app-graphical.slice/unrelated.service", &[99]);
+        let app = application("org.example.foo-bar", "/nix/store/test/bin/example");
+        let available = HashMap::from([(app.id.clone(), app)]);
+        let result = running_apps_in_slice(&tree.0, &available);
+        assert_eq!(result.len(), 1);
+        let pids = &result.get("org.example.foo-bar").unwrap().1;
+        assert_eq!(pids.iter().map(|pid| pid.get()).collect::<Vec<_>>(), vec![41, 42, 43]);
+    }
+
+    #[test]
+    fn uwsm_command_alias_is_unique() {
+        let tree = CgroupTree::new();
+        tree.pids("app-graphical.slice/app-river-example@abcdef01.service", &[51]);
+        let app = application("org.example.App", "/nix/store/test/bin/example");
+        let mut available = HashMap::from([(app.id.clone(), app)]);
+        let result = running_apps_in_slice(&tree.0, &available);
+        assert_eq!(result.get("org.example.App").unwrap().1[0].get(), 51);
+        let other = application("org.example.Other", "/nix/store/test/bin/example");
+        available.insert(other.id.clone(), other);
+        assert!(running_apps_in_slice(&tree.0, &available).is_empty());
+    }
+
+    #[test]
+    fn uwsm_recognized_app_owns_its_subtree() {
+        let tree = CgroupTree::new();
+        tree.pids("app-org.example.Parent.slice", &[61]);
+        tree.pids("app-org.example.Parent.slice/app-org.example.Child.service", &[62]);
+        let parent = application("org.example.Parent", "/bin/parent");
+        let child = application("org.example.Child", "/bin/child");
+        let available = HashMap::from([(parent.id.clone(), parent), (child.id.clone(), child)]);
+        let result = running_apps_in_slice(&tree.0, &available);
+        assert_eq!(result.len(), 1);
+        assert_eq!(result.get("org.example.Parent").unwrap().1.len(), 2);
+    }
+
+    #[test]
+    fn uwsm_flat_app_and_symlink_boundary() {
+        let tree = CgroupTree::new();
+        tree.pids("app-river-org.example.App@ab12.service", &[71]);
+        let outside = CgroupTree::new();
+        outside.pids("app-river-org.example.App@cd34.service", &[72]);
+        std::os::unix::fs::symlink(&outside.0, tree.0.join("app-linked.slice")).unwrap();
+        let app = application("org.example.App", "/bin/example");
+        let available = HashMap::from([(app.id.clone(), app)]);
+        let result = running_apps_in_slice(&tree.0, &available);
+        assert_eq!(result.get("org.example.App").unwrap().1.len(), 1);
+    }
 
