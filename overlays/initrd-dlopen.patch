+// UAPI.12 specifies ordered alternatives, not simultaneous dependencies.
+// Search every runpath for the preferred soname before trying its fallback.
+fn find_library(sonames: &[String], rpaths: &[Box<Path>]) -> Option<PathBuf> {
+    sonames.iter().find_map(|soname| {
+        rpaths.iter().find_map(|rpath| {
+            let library = rpath.join(soname);
+            library.exists().then_some(library)
+        })
+    })
 }
 
