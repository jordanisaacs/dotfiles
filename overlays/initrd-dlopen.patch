+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dlopen_sonames_are_ordered_alternatives() {
+        let root = env::temp_dir().join(format!("initrd-dlopen-test-{}", std::process::id()));
+        let first = root.join("first");
+        let second = root.join("second");
+        fs::create_dir_all(&first).unwrap();
+        fs::create_dir_all(&second).unwrap();
+        fs::write(first.join("libexample.so.1"), []).unwrap();
+        fs::write(second.join("libexample.so.2"), []).unwrap();
+        let rpaths = vec![Box::from(first.as_path()), Box::from(second.as_path())];
+        let names = |values: &[&str]| {
+            values
+                .iter()
+                .map(|value| value.to_string())
+                .collect::<Vec<_>>()
+        };
+
+        // Soname preference takes precedence over runpath order.
+        assert_eq!(
+            find_library(&names(&["libexample.so.2", "libexample.so.1"]), &rpaths),
+            Some(second.join("libexample.so.2")),
+        );
+        // An unavailable preferred ABI must not prevent using its fallback.
+        assert_eq!(
+            find_library(&names(&["libexample.so.3", "libexample.so.1"]), &rpaths),
+            Some(first.join("libexample.so.1")),
+        );
+        assert_eq!(
+            find_library(&names(&["libmissing.so.2", "libmissing.so.1"]), &rpaths),
+            None
+        );
+        // DT_NEEDED libraries use the same resolver with one required soname.
+        assert_eq!(
+            find_library(&names(&["libexample.so.1"]), &rpaths),
+            Some(first.join("libexample.so.1"))
+        );
+        fs::remove_dir_all(root).unwrap();
+    }
+}
