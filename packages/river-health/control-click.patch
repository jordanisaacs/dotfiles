+/// Multiple physical buttons may map to one logical button. Only emit the
+/// first press and final release, preserving the client's implicit pointer grab.
+fn notifyButton(cursor: *Cursor, event: *const Seat.Event.PointerButton, button: u32) void {
+    var it = cursor.pressed.iterator();
+    while (it.next()) |entry| {
+        if (entry.key_ptr.* == event.button) continue;
+        if (entry.value_ptr.button) |logical_button| {
+            if (logical_button == button) return;
+        }
+    }
+    _ = cursor.seat.wlr_seat.pointerNotifyButton(event.time_msec, button, event.state);
+}
